@model FastPMS.Models.Domain.SubTask
@{
    ViewData["Title"] = "Sub-Task Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class='bx bx-detail'></i>
                            Sub-Task Details
                        </h4>
                        <div>
                            <a asp-action="SubTaskEdit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                                <i class='bx bx-edit'></i> Edit
                            </a>
                            <a asp-action="AllSubTasks" class="btn btn-secondary btn-sm">
                                <i class='bx bx-arrow-back'></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-4">
                                <h3 class="text-primary">@Model.Title</h3>
                                @if (!string.IsNullOrEmpty(Model.Description))
                                {
                                    <p class="text-muted mt-2 lead">@Model.Description</p>
                                }
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Parent Task:</label>
                                        <p class="fs-6">@Model.ProjectTask?.Title</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Project:</label>
                                        <p class="fs-6">@Model.ProjectTask?.Project?.ProjectTitle</p>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Assigned To:</label>
                                        <p class="fs-6">@Model.AssignedTo?.FullName</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Assigned By:</label>
                                        <p class="fs-6">@Model.AssignedBy?.FullName</p>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Status:</label>
                                        <br />
                                        <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">@Model.Status</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Priority:</label>
                                        <br />
                                        <span class="badge @GetPriorityBadgeClass(Model.Priority) fs-6">@Model.Priority</span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Due Date:</label>
                                        <p class="fs-6 @(Model.DueDate < DateTime.Now && Model.Status != "Completed" ? "text-danger fw-bold" : "")">
                                            @Model.DueDate.ToString("MMM dd, yyyy")
                                            @if (Model.DueDate < DateTime.Now && Model.Status != "Completed")
                                            {
                                                <br />
                                            
                                                <small class="text-danger">Overdue!</small>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Estimated Hours:</label>
                                        <p class="fs-6">@Model.EstimatedHours hours</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-muted">Actual Hours:</label>
                                        <p class="fs-6">@(Model.ActualHours > 0 ? Model.ActualHours + " hours" : "Not set")</p>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold text-muted">Notes:</label>
                                    <div class="border p-3 rounded bg-light">
                                        <p class="mb-0">@Model.Notes</p>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-4">
                            <div class="card shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class='bx bx-time'></i> Timeline</h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <small class="text-muted">Created</small>
                                        <p class="mb-1 fw-semibold">@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                                    </div>
                                    <div class="mb-3">
                                        <small class="text-muted">Last Updated</small>
                                        <p class="mb-1 fw-semibold">@Model.UpdatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                                    </div>
                                    @if (Model.CompletedDate.HasValue)
                                    {
                                        <div class="mb-3">
                                            <small class="text-muted">Completed</small>
                                            <p class="mb-1 fw-semibold text-success">@Model.CompletedDate.Value.ToString("MMM dd, yyyy hh:mm tt")</p>
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <small class="text-muted">Due Date</small>
                                        <p class="mb-1 fw-semibold @(Model.DueDate < DateTime.Now && Model.Status != "Completed" ? "text-danger" : "text-success")">
                                            @Model.DueDate.ToString("MMM dd, yyyy hh:mm tt")
                                        </p>
                                    </div>
                                </div>
                            </div>

                            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.Identity.Name == Model.AssignedTo?.UserName)
                            {
                                <div class="card shadow-sm mt-3">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0"><i class='bx bx-cog'></i> Quick Actions</h6>
                                    </div>
                                    <div class="card-body">
                                        <label class="form-label">Update Status:</label>
                                        <select class="form-select mb-2" id="statusUpdate" data-subtask-id="@Model.Id">
                                            <option value="Not Started" selected="@(Model.Status == "Not Started")">Not Started</option>
                                            <option value="In Progress" selected="@(Model.Status == "In Progress")">In Progress</option>
                                            <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                                            <option value="On Hold" selected="@(Model.Status == "On Hold")">On Hold</option>
                                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                                        </select>
                                        <button type="button" class="btn btn-primary btn-sm w-100" onclick="updateStatus()">
                                            <i class='bx bx-refresh'></i> Update Status
                                        </button>

                                        <div class="mt-3">
                                            <a asp-action="SubTaskEdit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm w-100 mb-2">
                                                <i class='bx bx-edit'></i> Edit Sub-Task
                                            </a>
                                            <a asp-action="SubTaskDelete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm w-100">
                                                <i class='bx bx-trash'></i> Delete Sub-Task
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function updateStatus() {
            var subTaskId = $('#statusUpdate').data('subtask-id');
            var newStatus = $('#statusUpdate').val();

            $.ajax({
                url: '@Url.Action("SubTaskUpdateStatus", "SubTask")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    subTaskId: subTaskId,
                    status: newStatus
                }),
                success: function(response) {
                    if (response.success) {
                        showToast('Success', response.message, 'success');
                        setTimeout(function() {
                            location.reload();
                        }, 1500);
                    } else {
                        showToast('Error', response.error, 'error');
                    }
                },
                error: function() {
                    showToast('Error', 'Failed to update status', 'error');
                }
            });
        }

        function showToast(title, message, type) {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
            });

            Toast.fire({
                icon: type,
                title: title,
                text: message
            });
        }
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Not Started" => "bg-secondary",
            "In Progress" => "bg-primary",
            "Completed" => "bg-success",
            "On Hold" => "bg-warning",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority switch
        {
            "Low" => "bg-secondary",
            "Medium" => "bg-info",
            "High" => "bg-warning",
            "Urgent" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}