@model FastPMS.Models.ViewModel.SubTaskEditViewModel
@{
    ViewData["Title"] = "Edit Sub-Task";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class='bx bx-edit'></i>
                        Edit Sub-Task
                    </h4>
                </div>
                <div class="card-body">
                    <!-- Success/Error Messages -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class='bx bx-check-circle'></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class='bx bx-error-circle'></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="SubTaskEdit" method="post" id="subTaskForm" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Title" class="form-label">Sub-Task Title *</label>
                                    <input asp-for="Title" class="form-control" required />
                                    <span asp-validation-for="Title" class="text-danger"></span>
                                    <div class="invalid-feedback">Please provide a sub-task title.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ProjectTaskId" class="form-label">Parent Task *</label>
                                    <select asp-for="ProjectTaskId" class="form-select" required>
                                        <option value="">-- Select Parent Task --</option>
                                        @if (ViewBag.AvailableTasks != null)
                                        {
                                            @foreach (var task in ViewBag.AvailableTasks)
                                            {
                                                <option value="@task.Id">@task.Title - @task.Project?.ProjectTitle</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="ProjectTaskId" class="text-danger"></span>
                                    <div class="invalid-feedback">Please select a parent task.</div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AssignedToId" class="form-label">Assign To *</label>
                                    <select asp-for="AssignedToId" class="form-select" required>
                                        <option value="">-- Select Team Member --</option>
                                        @if (ViewBag.AvailableTeamMembers != null)
                                        {
                                            @foreach (var user in ViewBag.AvailableTeamMembers)
                                            {
                                                <option value="@user.Id">@user.FullName (@user.UserName)</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="AssignedToId" class="text-danger"></span>
                                    <div class="invalid-feedback">Please assign to a team member.</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="DueDate" class="form-label">Due Date *</label>
                                    <input asp-for="DueDate" type="date" class="form-control" required />
                                    <span asp-validation-for="DueDate" class="text-danger"></span>
                                    <div class="invalid-feedback">Please select a due date.</div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Priority" class="form-label">Priority Level</label>
                                    <select asp-for="Priority" class="form-select">
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                        <option value="Urgent">Urgent</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Status" class="form-label">Status</label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="Not Started">Not Started</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="On Hold">On Hold</option>
                                        <option value="Cancelled">Cancelled</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="EstimatedHours" class="form-label">Estimated Hours</label>
                                    <input asp-for="EstimatedHours" type="number" step="0.5" class="form-control" />
                                    <span asp-validation-for="EstimatedHours" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ActualHours" class="form-label">Actual Hours</label>
                                    <input asp-for="ActualHours" type="number" step="0.5" class="form-control" />
                                    <span asp-validation-for="ActualHours" class="text-danger"></span>
                                    <div class="form-text">Enter actual hours spent on this sub-task</div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Additional Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-warning">
                                <i class='bx bx-save'></i> Update Sub-Task
                            </button>
                            <a asp-action="SubTaskDetails" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class='bx bx-show'></i> View Details
                            </a>
                            <a asp-action="AllSubTasks" class="btn btn-secondary">
                                <i class='bx bx-arrow-back'></i> Back to List
                            </a>
                            <button type="reset" class="btn btn-outline-secondary">
                                <i class='bx bx-reset'></i> Reset
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Set minimum date to today
            var today = new Date().toISOString().split('T')[0];
            $('#DueDate').attr('min', today);

            // Bootstrap validation
            var form = document.getElementById('subTaskForm');
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);

            // Set selected values for dropdowns
            $('#ProjectTaskId').val('@Model.ProjectTaskId');
            $('#AssignedToId').val('@Model.AssignedToId');
            $('#Priority').val('@Model.Priority');
            $('#Status').val('@Model.Status');
        });
    </script>
}