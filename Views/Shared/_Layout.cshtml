<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FastPMS</title>

    <!-- CSS Libraries -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FastPMS.styles.css" asp-append-version="true" />

    <!-- Icon Libraries -->
    <link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- UI Libraries -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <!-- Render additional styles from views -->
    @RenderSection("Styles", required: false)
</head>
<body>
    <section class="sidebar">
        <div class="nav-header">
            <p class="logo">FAST PMS</p>
            <i class="bx bx-menu btn-menu"></i>
        </div>
        <ul class="nav-links">
            <!-- Search Bar -->
            <li>
                <i class="bx bx-search search-btn"></i>
                <input type="text" placeholder="Search projects, tasks..." id="globalSearch" />
                <span class="tooltip">Search</span>
            </li>

            <!-- Dashboard -->
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="bx bx-home-alt-2"></i>
                    <span class="title">Dashboard</span>
                </a>
                <span class="tooltip">Dashboard</span>
            </li>

            <!-- SUPER ADMIN & ADMIN MENU -->
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <!-- Project Management -->
                <li class="nav-section-header">
                </li>
                <li>
                    <a asp-controller="AdminProject" asp-action="CreateProject">
                        <i class='bx bx-folder-plus'></i>
                        <span class="title">Create Project</span>
                    </a>
                    <span class="tooltip">Create Project</span>
                </li>
                <li>
                    <a asp-controller="AdminProject" asp-action="AllProject">
                        <i class='bx bx-folder-open'></i>
                        <span class="title">All Projects</span>
                        @{
                            var totalProjects = ViewBag.TotalProjects ?? 0;
                            if (totalProjects > 0)
                            {
                                <span class="badge bg-primary badge-sm">@totalProjects</span>
                            }
                        }
                    </a>
                    <span class="tooltip">All Projects</span>
                </li>

                <!-- Task Management -->
                <li class="nav-section-header">
                </li>
                <li>
                    <a asp-controller="Task" asp-action="Create">
                        <i class='bx bx-task'></i>
                        <span class="title">Create Task</span>
                    </a>
                    <span class="tooltip">Create Task</span>
                </li>
                <li>
                    <a asp-controller="Task" asp-action="AllTasks">
                        <i class='bx bx-list-check'></i>
                        <span class="title">All Tasks</span>
                        @{
                            var totalTasks = ViewBag.TotalTasks ?? 0;
                            if (totalTasks > 0)
                            {
                                <span class="badge bg-info badge-sm">@totalTasks</span>
                            }
                        }
                    </a>
                    <span class="tooltip">All Tasks</span>
                </li>

                <!-- Sub-Task Management -->
                <li>
                    <a asp-controller="SubTask" asp-action="SubTaskCreate">
                        <i class='bx bx-add-to-queue'></i>
                        <span class="title">Create Sub-Task</span>
                    </a>
                    <span class="tooltip">Create Sub-Task</span>
                </li>
                <li>
                    <a asp-controller="SubTask" asp-action="AllSubTasks">
                        <i class='bx bx-list-ul'></i>
                        <span class="title">All Sub-Tasks</span>
                        @{
                            var totalSubTasks = ViewBag.TotalSubTasks ?? 0;
                            if (totalSubTasks > 0)
                            {
                                <span class="badge bg-warning badge-sm">@totalSubTasks</span>
                            }
                        }
                    </a>
                    <span class="tooltip">All Sub-Tasks</span>
                </li>

                <!-- Team Management -->
                <li class="nav-section-header">
                </li>
                @if (User.IsInRole("SuperAdmin"))
                {
                    <li>
                        <a asp-controller="Account" asp-action="Register">
                            <i class='bx bx-user-plus'></i>
                            <span class="title">Add Developer</span>
                        </a>
                        <span class="tooltip">Add Developer</span>
                    </li>
                }
                <li>
                    <a asp-controller="AdminProject" asp-action="AllDeveloper">
                        <i class='bx bxl-microsoft-teams'></i>
                        <span class="title">Manage Team</span>
                    </a>
                    <span class="tooltip">Manage Team</span>
                </li>
                <li>
                    <a asp-controller="Project" asp-action="Assign">
                        <i class='bx bx-user-check'></i>
                        <span class="title">Assign Project</span>
                    </a>
                    <span class="tooltip">Assign Project</span>
                </li>

                <!-- Communication -->
                <li class="nav-section-header">
                </li>
                <li>
                    <a asp-controller="Chat" asp-action="Index">
                        <i class='bx bx-message-rounded-dots'></i>
                        <span class="title">Live Chat</span>
                        @{
                            var unreadMessages = ViewBag.UnreadMessages ?? 0;
                            if (unreadMessages > 0)
                            {
                                <span class="badge bg-danger badge-sm">@unreadMessages</span>
                            }
                        }
                    </a>
                    <span class="tooltip">Live Chat</span>
                </li>
            }

            <!-- TEAM MEMBER MENU -->
            @if (User.IsInRole("TeamMember"))
            {
                <li class="nav-section-header">
                    <span class="title">My Work</span>
                </li>
                <li>
                    <a asp-controller="Project" asp-action="MyProjects">
                        <i class='bx bx-folder'></i>
                        <span class="title">My Projects</span>
                        @{
                            var myProjectCount = ViewBag.MyProjectCount ?? 0;
                            if (myProjectCount > 0)
                            {
                                <span class="badge bg-primary badge-sm">@myProjectCount</span>
                            }
                        }
                    </a>
                    <span class="tooltip">My Projects</span>
                </li>
                <li>
                    <a asp-controller="Task" asp-action="MyTasks">
                        <i class='bx bx-task'></i>
                        <span class="title">My Tasks</span>
                        @{
                            var myTaskCount = ViewBag.MyTaskCount ?? 0;
                            if (myTaskCount > 0)
                            {
                                <span class="badge bg-info badge-sm">@myTaskCount</span>
                            }
                        }
                    </a>
                    <span class="tooltip">My Tasks</span>
                </li>
                <li>
                    <a asp-controller="SubTask" asp-action="MySubTasks">
                        <i class='bx bx-list-check'></i>
                        <span class="title">My Sub-Tasks</span>
                        @{
                            var mySubTaskCount = ViewBag.MySubTaskCount ?? 0;
                            if (mySubTaskCount > 0)
                            {
                                <span class="badge bg-warning badge-sm">@mySubTaskCount</span>
                            }
                        }
                    </a>
                    <span class="tooltip">My Sub-Tasks</span>
                </li>

                <li class="nav-section-header">
                </li>
                <li>
                    <a asp-controller="Chat" asp-action="Index">
                        <i class='bx bx-message-rounded-dots'></i>
                        <span class="title">Live Chat</span>
                        @{
                            var teamUnreadMessages = ViewBag.UnreadMessages ?? 0;
                            if (teamUnreadMessages > 0)
                            {
                                <span class="badge bg-danger badge-sm">@teamUnreadMessages</span>
                            }
                        }
                    </a>
                    <span class="tooltip">Live Chat</span>
                </li>
            }

            <!-- CLIENT MENU -->
            @if (User.IsInRole("Client"))
            {
                <li class="nav-section-header">
                    <span class="title">My Projects</span>
                </li>
                <li>
                    <a asp-controller="Project" asp-action="MyProjectStatus">
                        <i class='bx bx-folder'></i>
                        <span class="title">Project Status</span>
                        @{
                            var clientProjectCount = ViewBag.ClientProjectCount ?? 0;
                            if (clientProjectCount > 0)
                            {
                                <span class="badge bg-primary badge-sm">@clientProjectCount</span>
                            }
                        }
                    </a>
                    <span class="tooltip">Project Status</span>
                </li>

                <li class="nav-section-header">
                    <span class="title">Account</span>
                </li>
                <li>
                    <a asp-controller="Project" asp-action="MyProfile">
                        <i class='bx bx-user'></i>
                        <span class="title">My Profile</span>
                    </a>
                    <span class="tooltip">My Profile</span>
                </li>

                <li class="nav-section-header">
                    <span class="title">Support</span>
                </li>
                <li>
                    <a asp-controller="Chat" asp-action="Index">
                        <i class='bx bx-message-rounded-dots'></i>
                        <span class="title">Contact Support</span>
                    </a>
                    <span class="tooltip">Contact Support</span>
                </li>
            }

            <!-- BOTTOM SECTION - User Info & Actions -->
            @if (User.Identity.IsAuthenticated)
            {
                <!-- User Info -->
                <li class="user-info">
                    <div class="user-details">
                        <i class='bx bx-user-circle'></i>
                        <span class="title">
                            <small class="username">@User.Identity.Name</small>
                            <br>
                            <small class="user-role">
                                @{
                                    var claims = Context.User.Claims;
                                    var roleClaim = claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role);
                                    var role = roleClaim?.Value ?? "User";
                                }
                                @role
                            </small>
                        </span>
                    </div>
                </li>

                <!-- Quick Actions -->
                <li class="nav-section-header">
                </li>

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Dashboard" asp-action="Reports">
                            <i class='bx bx-bar-chart-alt'></i>
                            <span class="title">Reports</span>
                        </a>
                        <span class="tooltip">Reports</span>
                    </li>
                }

                <li>
                    <a asp-controller="Notification" asp-action="Index">
                        <i class='bx bx-bell'></i>
                        <span class="title">Notifications</span>
                        <span class="badge bg-danger badge-sm" id="notificationBadge" style="display: none;">0</span>
                    </a>
                    <span class="tooltip">Notifications</span>
                </li>

                <!-- Logout Button -->
                <li class="logout-section">
                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                        <a href="#" onclick="confirmLogout(event)">
                            <i class='bx bx-log-out'></i>
                            <span class="title">Logout</span>
                        </a>
                    </form>
                    <span class="tooltip">Logout</span>
                </li>
            }
            else
            {
                <!-- Login Button for non-authenticated users -->
                <li>
                    <a asp-controller="Account" asp-action="Login">
                        <i class='bx bx-log-in'></i>
                        <span class="title">Login</span>
                    </a>
                    <span class="tooltip">Login</span>
                </li>
            }
        </ul>
    </section>

    <section class="home">
        <div class="container-fluid ps-4">
            <!-- Notification Toast Container -->
            <div id="notificationToastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1055;"></div>

            <!-- Main Content -->
            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="text-center mt-5 py-3 border-top">
                <h6>&copy; 2024 - Fast Project Management System | Developed by Shahadat Hossain</h6>
            </footer>
        </div>
    </section>

    <!-- AI Assistant Partial View -->
    @await Html.PartialAsync("_AIChatButton")

    <!-- JavaScript Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Main Layout Script -->
    <script>
        // Sidebar Toggle Functionality
        const btn_menu = document.querySelector(".btn-menu");
        const side_bar = document.querySelector(".sidebar");

        btn_menu.addEventListener("click", function () {
            side_bar.classList.toggle("expand");
            changebtn();
            // Save sidebar state to localStorage
            localStorage.setItem('sidebarExpanded', side_bar.classList.contains("expand"));
        });

        function changebtn() {
            if (side_bar.classList.contains("expand")) {
                btn_menu.classList.replace("bx-menu", "bx-menu-alt-right");
            } else {
                btn_menu.classList.replace("bx-menu-alt-right", "bx-menu");
            }
        }

        // Restore sidebar state on page load
        document.addEventListener('DOMContentLoaded', function() {
            const savedState = localStorage.getItem('sidebarExpanded');
            if (savedState === 'true') {
                side_bar.classList.add("expand");
                changebtn();
            }
        });

        // Enhanced logout confirmation with SweetAlert
        function confirmLogout(event) {
            event.preventDefault();

            Swal.fire({
                title: 'Confirm Logout',
                text: "Are you sure you want to logout?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Logout!',
                cancelButtonText: 'Cancel',
                background: '#1a1a1a',
                color: '#fff',
                iconColor: '#ff6b6b'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            });
        }

        // Global Search Functionality
        document.querySelector('.search-btn').addEventListener('click', performSearch);
        document.getElementById('globalSearch').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });

        function performSearch() {
            const searchTerm = document.getElementById('globalSearch').value.trim();

            if (searchTerm) {
                // Show loading state
                const searchBtn = document.querySelector('.search-btn');
                const originalClass = searchBtn.className;
                searchBtn.className = 'bx bx-loader-alt spinner';

                // Simulate search (replace with actual search implementation)
                setTimeout(() => {
                    searchBtn.className = originalClass;

                    // Redirect to search page or show results
                    Swal.fire({
                        title: 'Search Results',
                        text: `Searching for: "${searchTerm}"`,
                        icon: 'info',
                        timer: 2000,
                        showConfirmButton: false,
                        background: '#1a1a1a',
                        color: '#fff'
                    });
                }, 1000);
            }
        }

        // Auto-hide alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });

        // Initialize DataTables on tables with the 'datatable' class
        $(document).ready(function() {
            $('.datatable').DataTable({
                "pageLength": 25,
                "responsive": true,
                "autoWidth": false,
                "language": {
                    "search": "Search:",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                    "paginate": {
                        "previous": "Previous",
                        "next": "Next"
                    }
                }
            });
        });
    </script>

    <!-- SignalR and Notification System -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeNotificationHub();
            loadNotifications();
        });

        function initializeNotificationHub() {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();

            connection.start().then(function () {
                console.log("✅ Notification Hub Connected");
                connection.invoke("JoinNotificationGroup", "@User.Identity.Name");
            }).catch(function (err) {
                console.error("❌ Notification Hub Connection Failed: ", err.toString());
            });

            // Listen for new notifications
            connection.on("ReceiveNotification", function (notification) {
                console.log("📢 New notification received:", notification);
                addNotificationToUI(notification);
                updateNotificationBadge();
                showNotificationToast(notification);
            });

            // Handle reconnection
            connection.onreconnected(function() {
                console.log("🔄 Notification Hub Reconnected");
                loadNotifications();
            });
        }

        function loadNotifications() {
            fetch('@Url.Action("GetNotifications", "Notification")')
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(data => {
                    updateNotificationList(data.notifications || []);
                    updateNotificationBadge(data.unreadCount || 0);
                })
                .catch(error => {
                    console.error('❌ Error loading notifications:', error);
                });
        }

        function updateNotificationList(notifications) {
            const notificationList = document.getElementById('notificationList');
            if (!notificationList) return;

            if (notifications.length === 0) {
                notificationList.innerHTML = `
                    <div class="text-center text-muted py-3">
                        <i class='bx bx-bell-off fs-1'></i>
                        <p class="mb-0 mt-2">No notifications</p>
                    </div>
                `;
                return;
            }

            notificationList.innerHTML = notifications.map(notification => `
                <div class="notification-item mb-2 p-2 border rounded ${!notification.isRead ? 'bg-light bg-opacity-10' : ''}"
                     data-notification-id="${notification.id}">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 small">${escapeHtml(notification.message)}</p>
                            <small class="text-muted">${formatTime(notification.createdAt)}</small>
                        </div>
                        ${!notification.isRead ? '<span class="badge bg-primary ms-2">New</span>' : ''}
                    </div>
                </div>
            `).join('');

            // Add click event to mark as read
            document.querySelectorAll('.notification-item').forEach(item => {
                item.addEventListener('click', function() {
                    const notificationId = this.getAttribute('data-notification-id');
                    markAsRead(notificationId);
                });
            });
        }

        function addNotificationToUI(notification) {
            const notificationList = document.getElementById('notificationList');
            if (!notificationList) return;

            // Remove "no notifications" message if present
            if (notificationList.querySelector('.text-muted')) {
                notificationList.innerHTML = '';
            }

            const notificationHtml = `
                <div class="notification-item mb-2 p-2 border rounded bg-light bg-opacity-10"
                     data-notification-id="${notification.id}">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <p class="mb-1 small">${escapeHtml(notification.message)}</p>
                            <small class="text-muted">Just now</small>
                        </div>
                        <span class="badge bg-primary ms-2">New</span>
                    </div>
                </div>
            `;

            notificationList.innerHTML = notificationHtml + notificationList.innerHTML;
        }

        function updateNotificationBadge(count = null) {
            const badge = document.getElementById('notificationBadge');
            if (!badge) return;

            if (count !== null) {
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            }
        }

        function markAsRead(notificationId) {
            fetch('@Url.Action("MarkAsRead", "Notification")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({ notificationId: notificationId })
            }).then(() => {
                loadNotifications();
            }).catch(error => {
                console.error('Error marking notification as read:', error);
            });
        }

        function showNotificationToast(notification) {
            Swal.fire({
                title: 'New Notification',
                text: notification.message,
                icon: 'info',
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                background: '#1a1a1a',
                color: '#fff',
                iconColor: '#4e73df'
            });
        }

        function formatTime(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffMs = now - date;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Just now';
            if (diffMins < 60) return `${diffMins}m ago`;
            if (diffHours < 24) return `${diffHours}h ago`;
            if (diffDays < 7) return `${diffDays}d ago`;
            return date.toLocaleDateString();
        }

        function escapeHtml(unsafe) {
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>

    <!-- Render additional scripts from views -->
    @RenderSection("Scripts", required: false)

</body>
</html>