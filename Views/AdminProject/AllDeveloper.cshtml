@model List<FastPMS.Models.Domain.Users>
@{
    ViewData["Title"] = "Team Members";
}

<html>
<link rel="stylesheet" href="~/css/buttonStyle.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<head>
    <style>
        .team-page {
            margin-top: 30px;
            padding: 20px;
        }

        /* ✅ STATISTICS SECTION STYLES */
        .stats-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .stat-item {
            text-align: center;
            padding: 15px;
            transition: all 0.3s ease;
        }

            .stat-item:hover {
                transform: translateY(-5px);
            }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 5px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
            font-weight: 500;
        }

        /* Team Member Card Styles */
        .team-member-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            padding: 20px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            border-left: 5px solid #4e73df;
            position: relative;
        }

            .team-member-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            }

        .member-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: bold;
            margin-right: 15px;
        }

        .department-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #36b9cc;
            color: white;
            display: inline-block;
            margin-top: 5px;
        }

        .role-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #1cc88a;
            color: white;
            display: inline-block;
        }

        .btn-view {
            background: #4e73df;
            color: white;
            border: none;
            padding: 6px 15px;
            border-radius: 8px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

            .btn-view:hover {
                background: #2e59d9;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .btn-delete {
            background: #e74a3b;
            color: white;
            border: none;
            padding: 6px 15px;
            border-radius: 8px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

            .btn-delete:hover {
                background: #c82333;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .action-buttons {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        .search-box {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 25px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #f8f9fa;
            border-radius: 15px;
            margin: 30px 0;
        }

        .delete-confirm-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="container team-page">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1" style="color: #2d3748;">
                    <i class="fas fa-users me-2"></i>Team Members
                </h2>
                <p class="text-muted mb-0">Manage all team members in the system</p>
            </div>

            <div>
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none me-2">
                    <button class="cssbuttons-io-button">
                        <i class="fas fa-user-plus me-2"></i>Add Member
                        <div class="icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" viewBox="0 0 24 24" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" stroke="currentColor" height="24" fill="none" class="svg">
                                <line y2="19" y1="5" x2="12" x1="12"></line>
                                <line y2="12" y1="12" x2="19" x1="5"></line>
                            </svg>
                        </div>
                    </button>
                </a>
            </div>
        </div>

        <!-- ✅ STATISTICS SECTION (SEARCH BOX ER UPPORE) -->
        <div class="stats-section">
            <h5 class="mb-3"><i class="fas fa-chart-pie me-2"></i>System Statistics</h5>
            <div class="row">
                <div class="col-md-2 col-sm-4 col-6 stat-item">
                    <div class="stat-number">@(ViewBag.TotalUsers ?? 0)</div>
                    <div class="stat-label">Total Users</div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 stat-item">
                    <div class="stat-number">@(ViewBag.TeamMemberCount ?? 0)</div>
                    <div class="stat-label">Team Members</div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 stat-item">
                    <div class="stat-number">@(ViewBag.AdminCount ?? 0)</div>
                    <div class="stat-label">Admins</div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 stat-item">
                    <div class="stat-number">@(ViewBag.SuperAdminCount ?? 0)</div>
                    <div class="stat-label">Super Admins</div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 stat-item">
                    <div class="stat-number">@(ViewBag.ClientCount ?? 0)</div>
                    <div class="stat-label">Clients</div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 stat-item">
                    <div class="stat-number">@(Model?.Count ?? 0)</div>
                    <div class="stat-label">Showing</div>
                </div>
            </div>
        </div>

        <!-- Search Box -->
        <div class="search-box">
            <form method="get" action="@Url.Action("AllDeveloper")" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control"
                               placeholder="Search by name, email, username or department..."
                               value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="department" class="form-select" onchange="this.form.submit()">
                        <option value="">All Departments</option>
                        @if (ViewBag.Departments != null)
                        {
                            @foreach (var dept in ViewBag.Departments)
                            {
                                <option value="@dept" selected="@(Context.Request.Query["department"] == dept)">
                                    @dept
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="@Url.Action("AllDeveloper")" class="btn btn-secondary w-100">
                        <i class="fas fa-redo me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>

        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Team Members List -->
        @if (Model != null && Model.Any())
        {
            <div class="row" id="teamMembersContainer">
                @foreach (var user in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4" id="user-@user.Id">
                        <div class="team-member-card">
                            <!-- Active Status Indicator -->
                            <div class="user-status" title="Active"></div>

                            <div class="d-flex align-items-start">
                                <!-- Avatar with initials -->
                                <div class="member-avatar">
                                    @GetInitials(user.FullName ?? user.UserName)
                                </div>

                                <div class="member-info" style="flex: 1;">
                                    <h6 class="mb-2 fw-bold">@(user.FullName ?? user.UserName)</h6>

                                    <div class="member-info-item">
                                        <i class="fas fa-envelope me-1"></i>
                                        <span>@user.Email</span>
                                    </div>

                                    <div class="member-info-item">
                                        <i class="fas fa-user me-1"></i>
                                        <span>@user.UserName</span>
                                    </div>

                                    <!-- Department Display -->
                                    <div class="member-info-item">
                                        <i class="fas fa-building me-1"></i>
                                        @if (!string.IsNullOrEmpty(user.Department))
                                        {
                                            <span class="department-badge">
                                                <i class="fas fa-briefcase me-1"></i>@user.Department
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="no-department">No department assigned</span>
                                        }
                                    </div>

                                    <!-- Role Badge -->
                                    <div class="member-info-item">
                                        <i class="fas fa-user-tag me-1"></i>
                                        <span class="role-badge">
                                            @user.Role
                                        </span>
                                    </div>

                                    <!-- User ID -->
                                    <div class="member-info-item">
                                        <i class="fas fa-id-card me-1"></i>
                                        <span class="text-muted small">ID: @(user.Id.Length > 8 ? user.Id.Substring(0, 8) + "..." : user.Id)</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons - VIEW and DELETE -->
                            <div class="mt-3 pt-3 border-top action-buttons">
                                <!-- View Button -->
                                <button class="btn btn-view" onclick="viewProfile('@user.Id')" title="View Profile">
                                    <i class="fas fa-eye me-1"></i> View
                                </button>

                                <!-- Delete Button with Confirmation -->
                                <button class="btn btn-delete"
                                        onclick="confirmDelete('@user.Id', '@(user.FullName ?? user.UserName)')"
                                        title="Delete User">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Results Info -->
            <div class="alert alert-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>@Model.Count</strong> team members found
                    </div>
                    <div>
                        <span class="text-muted">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Deleting a user will permanently remove their account
                        </span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="mb-4" style="font-size: 4rem; color: #6c757d;">
                    <i class="fas fa-users-slash"></i>
                </div>
                <h4 class="text-muted mb-3">No Team Members Found</h4>
                <p class="text-muted mb-4">No team members have registered yet.</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
                    <i class="fas fa-user-plus me-2"></i>Register First Team Member
                </a>
            </div>
        }

        <!-- Delete Confirmation Modal -->
        <div id="deleteModal" class="delete-confirm-modal">
            <div class="delete-modal-content">
                <div class="text-center">
                    <div class="delete-modal-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <h4 class="mb-3">Delete Team Member</h4>
                    <p id="deleteMessage" class="mb-4">Are you sure you want to delete this team member?</p>

                    <form id="deleteForm" method="post" asp-action="DeleteTeamMember">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="userIdToDelete" name="id" value="" />

                        <div class="d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">
                                <i class="fas fa-times me-1"></i> Cancel
                            </button>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i> Yes, Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // View Profile Function
        function viewProfile(userId) {
            Swal.fire({
                title: 'View Profile',
                text: 'Profile view functionality will be implemented here.',
                icon: 'info',
                confirmButtonText: 'OK'
            });
        }

        // Delete Confirmation with SweetAlert
        function confirmDelete(userId, userName) {
            Swal.fire({
                title: 'Delete Team Member?',
                html: `<p>Are you sure you want to delete <strong>${userName}</strong>?</p>
                      <p class="text-danger">This action cannot be undone!</p>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                showLoaderOnConfirm: true,
                preConfirm: () => {
                    return deleteUser(userId);
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Deleted!',
                        text: 'Team member has been deleted.',
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        // Remove the card from UI
                        const userCard = document.getElementById(`user-${userId}`);
                        if (userCard) {
                            userCard.remove();
                        }
                        // Reload the page to update statistics
                        setTimeout(() => {
                            location.reload();
                        }, 500);
                    });
                }
            });
        }

        // AJAX Delete Function
        function deleteUser(userId) {
            return fetch('@Url.Action("DeleteTeamMember", "AdminProject")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `id=${userId}`
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response;
            })
            .catch(error => {
                Swal.showValidationMessage(`Delete failed: ${error}`);
            });
        }

        // Auto-hide alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
</body>
</html>

@functions {
    // Helper function to get initials from name
    public string GetInitials(string name)
    {
        if (string.IsNullOrEmpty(name))
            return "??";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        else if (name.Length >= 2)
            return name.Substring(0, 2).ToUpper();
        else
            return name.ToUpper();
    }
}