@model FastPMS.Models.ViewModel.CreateTaskRequest

@{
    ViewData["Title"] = "Create New Task";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class='bx bx-plus-circle me-2'></i>Create New Task
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class='bx bx-check-circle me-2'></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Title" class="form-label">Task Title *</label>
                                <input asp-for="Title" class="form-control" placeholder="Enter task title">
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="4"
                                          placeholder="Describe the task details..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ProjectId" class="form-label">Project *</label>
                                <select asp-for="ProjectId" class="form-select">
                                    <option value="">-- Select Project --</option>
                                    @foreach (var project in ViewBag.Projects)
                                    {
                                        <!-- ✅ Use ProjectId (int) instead of Id (string) -->
                                        <option value="@project.ProjectId">@project.ProjectTitle</option>
                                    }
                                </select>
                                <span asp-validation-for="ProjectId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="AssignedToId" class="form-label">Assign To *</label>
                                <select asp-for="AssignedToId" class="form-select">
                                    <option value="">-- Select Team Member --</option>
                                    @foreach (var member in ViewBag.TeamMembers)
                                    {
                                        <option value="@member.Id">@member.FullName (@member.Role)</option>
                                    }
                                </select>
                                <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Priority" class="form-label">Priority *</label>
                                <select asp-for="Priority" class="form-select">
                                    @foreach (var priority in ViewBag.Priorities)
                                    {
                                        <option value="@priority">@priority</option>
                                    }
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="DueDate" class="form-label">Due Date *</label>
                                <input asp-for="DueDate" type="date" class="form-control">
                                <span asp-validation-for="DueDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="EstimatedHours" class="form-label">Estimated Hours</label>
                                <input asp-for="EstimatedHours" type="number" step="0.5" class="form-control"
                                       placeholder="e.g., 8.0">
                                <span asp-validation-for="EstimatedHours" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="@Url.Action("MyTasks", "Task")" class="btn btn-outline-secondary">
                                <i class='bx bx-arrow-back me-1'></i>Back to Tasks
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class='bx bx-save me-1'></i>Create Task
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set minimum date to today
        document.getElementById('DueDate').min = new Date().toISOString().split('T')[0];
    </script>
}