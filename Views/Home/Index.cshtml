@{
    ViewData["Title"] = "Home Page";

    // Get user role at the top level
    var roleClaim = Context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role);
    var userRole = roleClaim?.Value ?? "User";
    var isAuthenticated = User.Identity.IsAuthenticated;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FastPMS - Project Management System</title>
    <link rel="stylesheet" href="~/css/StyleSheet.css">
    <script defer src="script.js"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg pt-4">
        <div class="container">
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarButtonsExample"
                    aria-expanded="false">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarButtonsExample">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <h3><i class='bx bx-analyse'></i> Dashboard</h3>
                    </li>
                </ul>
                <div class="d-flex align-items-center ms-auto">
                    @if (isAuthenticated)
                    {
                        <!-- Notification Bell -->
                        <!-- Notification Bell -->
                        <div class="dropdown me-3">
                            <button class="btn btn-outline-secondary position-relative"
                                    type="button"
                                    id="notificationDropdown"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                <i class='bx bx-bell'></i>
                                <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none;">
                                    0
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="notificationDropdown" style="min-width: 350px;">
                                <li class="dropdown-header">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong>Notifications</strong>
                                        <div>
                                            <button id="markAllAsRead" class="btn btn-sm btn-outline-success me-2" title="Mark all as read">
                                                <i class='bx bx-check-double'></i>
                                            </button>
                                            <button id="refreshNotifications" class="btn btn-sm btn-outline-primary" title="Refresh">
                                                <i class='bx bx-refresh'></i>
                                            </button>
                                        </div>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <div id="notificationList" style="max-height: 300px; overflow-y: auto;">
                                    <div class="text-center p-4">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                        <span class="ms-2 text-muted">Loading notifications...</span>
                                    </div>
                                </div>
                                <li><hr class="dropdown-divider"></li>
                                <li class="text-center">
                                    <a href="@Url.Action("Index", "Notification")" class="dropdown-item text-primary">
                                        <i class='bx bx-list-ul me-1'></i>View All Notifications
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Authenticated User Menu -->
                        <div class="dropdown">
                            <button class="btn btn-outline-primary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class='bx bx-user me-1'></i>
                                @User.Identity.Name
                                <span class="badge bg-secondary ms-1">@userRole</span>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="@Url.Action("MyProfile", "Project")"><i class='bx bx-user me-2'></i>My Profile</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Notifications", "Account")"><i class='bx bx-bell me-2'></i>Notifications</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class='bx bx-log-out me-2'></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Guest User Menu -->
                        <a asp-controller="Account" asp-action="Login" type="button" class="btn btn-primary me-3">
                            <i class='bx bx-log-in me-1'></i>Login
                        </a>
                        <a asp-controller="Account" asp-action="Register" type="button" class="btn btn-outline-primary me-3">
                            <i class='bx bx-user-plus me-1'></i>Sign Up
                        </a>
                        <a href="https://github.com" role="button" class="fs-2 text-dark">
                            <i class='bx bxl-github'></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Welcome Section -->
    <div class="container mt-4">
        @if (isAuthenticated)    
        {
            <!-- Welcome Message for Authenticated Users -->
            <div class="row welcome mb-4">
                <div class="col-12">  
                    <div class="align-items-center" role="alert">  
                        <i class='bx bx-check-circle me-2 fs-4'></i> 
                        <div>
                            <h5 class="alert-heading mb-1">Welcome back, @User.Identity.Name! 👋</h5>
                            <p class="mb-0">You are logged in as <strong>@userRole</strong>. Here's your project overview.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Welcome Message for Guests -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class='bx bx-info-circle me-2 fs-4'></i>
                        <div>
                            <h5 class="alert-heading mb-1">Welcome to FastPMS! 🚀</h5>
                            <p class="mb-0">Please login or sign up to access your projects and manage your account.</p>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Logo Section -->
    <div class="d-flex justify-content-center mb-4">
        <img src="~/images/pms-logo.png" style="height:150px; width:500px" alt="FastPMS Logo" />
    </div>

    <!-- Role-Based Dashboard Content -->
    @if (isAuthenticated)
    {
        <!-- Authenticated User Dashboard -->
        <div class="container">
            <!-- Quick Actions Based on Role -->
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <!-- Admin Quick Actions -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-3"><i class='bx bx-rocket me-2 text-primary'></i>Quick Actions</h5>
                                <div class="row">
                                    <div class="col-md-3 mb-2">
                                        <a href="@Url.Action("CreateProject", "AdminProject")" class="btn btn-primary w-100">
                                            <i class='bx bx-plus me-1'></i>Create Project
                                        </a>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <a href="@Url.Action("AllProject", "AdminProject")" class="btn btn-outline-primary w-100">
                                            <i class='bx bx-folder me-1'></i>View Projects
                                        </a>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <a href="@Url.Action("TestNotification", "Home")" class="btn btn-outline-success w-100">
                                            <i class='bx bx-bell me-1'></i>Test Notifications
                                        </a>
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <a href="@Url.Action("SendWelcomeNotification", "Home")" class="btn btn-outline-info w-100">
                                            <i class='bx bx-user-plus me-1'></i>Welcome Message
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (User.IsInRole("TeamMember"))
            {
                <!-- Team Member Quick Actions -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-3"><i class='bx bx-task me-2 text-primary'></i>My Tasks</h5>
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <a href="@Url.Action("MyTasks", "Task")" class="btn btn-primary w-100">
                                            <i class='bx bx-list-check me-1'></i>View Tasks
                                        </a>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <a href="@Url.Action("MySubTasks", "Task")" class="btn btn-outline-primary w-100">
                                            <i class='bx bx-task me-1'></i>My Sub-Tasks
                                        </a>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <a href="@Url.Action("Index", "Chat")" class="btn btn-outline-info w-100">
                                            <i class='bx bx-chat me-1'></i>Team Chat
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (User.IsInRole("Client"))
            {
                <!-- Client Quick Actions -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title mb-3"><i class='bx bx-folder me-2 text-primary'></i>My Projects</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <a href="@Url.Action("MyProjectStatus", "Project")" class="btn btn-primary w-100">
                                            <i class='bx bx-show me-1'></i>View My Projects
                                        </a>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <a href="@Url.Action("Index", "Chat")" class="btn btn-outline-primary w-100">
                                            <i class='bx bx-message me-1'></i>Contact Support
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Project Statistics Section -->
            @if (User.IsInRole("Client"))
            {
                <!-- For Client Users - Show Project Access Card -->
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-lg" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <div class="card-body text-center text-white py-5">
                                <i class='bx bx-folder-open display-1 mb-3'></i>
                                <h3 class="mb-3">Your Project Dashboard</h3>
                                <p class="lead mb-4 opacity-75">
                                    Access all your assigned projects in one place. Track progress, view details, and stay updated with real-time status.
                                </p>
                                <a href="@Url.Action("MyProjectStatus", "Project")" class="btn btn-light btn-lg px-5 py-3 fw-bold">
                                    <i class='bx bx-show me-2'></i>Go to My Projects
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- For Non-Client Users (Admin/SuperAdmin/TeamMember) - Show Statistics with Chart -->
                <div class="row">
                    <div class="col-12">
                        <div class="card bg-primary text-white shadow mb-3">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5 class="card-title mb-1"><i class='bx bxs-folder'></i> Total Projects</h5>
                                        <p class="card-text mb-0">@ViewBag.TotalProjectsCount Projects in the system</p>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <h3 class="mb-0">@ViewBag.TotalProjectsCount</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Statistics Cards -->
                    <div class="col-lg-4">
                        <div class="row">
                            <div class="col-md-6 col-lg-12 mb-3">
                                <div class="card bg-light shadow">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="card-title text-muted mb-1"><i class='bx bx-radio-circle-marked text-secondary'></i> Not Started</h5>
                                                <p class="card-text fs-4 fw-bold">@ViewBag.NotStartedCount</p>
                                            </div>
                                            <div class="text-muted">
                                                <small>Projects</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-12 mb-3">
                                <div class="card bg-info text-white shadow">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="card-title mb-1"><i class='bx bxs-caret-up-circle'></i> In Progress</h5>
                                                <p class="card-text fs-4 fw-bold">@ViewBag.InProgressCount</p>
                                            </div>
                                            <div>
                                                <small>Active</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="row">
                            <div class="col-md-6 col-lg-12 mb-3">
                                <div class="card bg-warning shadow">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="card-title mb-1"><i class='bx bx-stop-circle'></i> On Hold</h5>
                                                <p class="card-text fs-4 fw-bold">@ViewBag.OnHoldCount</p>
                                            </div>
                                            <div class="text-muted">
                                                <small>Paused</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-12 mb-3">
                                <div class="card bg-success text-white shadow">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="card-title mb-1"><i class='bx bx-check-square'></i> Completed</h5>
                                                <p class="card-text fs-4 fw-bold">@ViewBag.CompletedCount</p>
                                            </div>
                                            <div>
                                                <small>Finished</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart Section -->
                    <div class="col-lg-4">
                        <div class="card border-0 shadow">
                            <div class="card-body">
                                <h5 class="card-title mb-3"><i class='bx bx-chart me-2'></i>Project Status Distribution</h5>
                                <div style="height: 250px;">
                                    <canvas id="projectStatusChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Chart Options -->
                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="card border-0 shadow">
                            <div class="card-body">
                                <h5 class="card-title mb-3"><i class='bx bx-pie-chart me-2'></i>Project Status Pie Chart</h5>
                                <div style="height: 300px;">
                                    <canvas id="projectPieChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow">
                            <div class="card-body">
                                <h5 class="card-title mb-3"><i class='bx bx-bar-chart me-2'></i>Project Status Bar Chart</h5>
                                <div style="height: 300px;">
                                    <canvas id="projectBarChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Additional Role-Specific Information -->
                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title text-primary mb-3">
                                        <i class='bx bx-stats me-2'></i>System Overview
                                    </h5>
                                    <div class="system-stats">
                                        <div class="stat-item d-flex justify-content-between py-2 border-bottom">
                                            <span class="text-muted">Total Users</span>
                                            <strong>@(ViewBag.TotalUsers ?? "Loading...")</strong>
                                        </div>
                                        <div class="stat-item d-flex justify-content-between py-2 border-bottom">
                                            <span class="text-muted">Active Projects</span>
                                            <strong>@ViewBag.InProgressCount</strong>
                                        </div>
                                        <div class="stat-item d-flex justify-content-between py-2">
                                            <span class="text-muted">Completion Rate</span>
                                            <strong>
                                                @{
                                                    var completionRate = ViewBag.TotalProjectsCount > 0 ?
                                                    Math.Round((ViewBag.CompletedCount / (double)ViewBag.TotalProjectsCount) * 100, 1) : 0;
                                                }
                                                @completionRate%
                                            </strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title text-success mb-3">
                                        <i class='bx bx-trending-up me-2'></i>Recent Activity
                                    </h5>
                                    <div class="activity-list">
                                        <div class="activity-item d-flex align-items-center py-2 border-bottom">
                                            <i class='bx bx-plus-circle text-success me-2'></i>
                                            <small>New project "Website Redesign" created</small>
                                        </div>
                                        <div class="activity-item d-flex align-items-center py-2 border-bottom">
                                            <i class='bx bx-check-circle text-primary me-2'></i>
                                            <small>Project "Mobile App" completed</small>
                                        </div>
                                        <div class="activity-item d-flex align-items-center py-2">
                                            <i class='bx bx-user-plus text-info me-2'></i>
                                            <small>New team member added</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <!-- Guest User Dashboard -->
        <div class="container">
            <!-- Feature Highlights -->
            <div class="row mb-5">
                <div class="col-12 text-center">
                    <h3 class="text-primary mb-4">Why Choose FastPMS?</h3>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card border-0 shadow-sm h-100 text-center">
                        <div class="card-body">
                            <i class='bx bx-rocket text-primary fs-1 mb-3'></i>
                            <h5 class="card-title">Efficient Project Management</h5>
                            <p class="card-text text-muted">Streamline your projects with our intuitive management tools and real-time collaboration.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card border-0 shadow-sm h-100 text-center">
                        <div class="card-body">
                            <i class='bx bx-group text-success fs-1 mb-3'></i>
                            <h5 class="card-title">Team Collaboration</h5>
                            <p class="card-text text-muted">Work seamlessly with your team members through integrated chat and task assignment.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card border-0 shadow-sm h-100 text-center">
                        <div class="card-body">
                            <i class='bx bx-chart text-info fs-1 mb-3'></i>
                            <h5 class="card-title">Real-time Analytics</h5>
                            <p class="card-text text-muted">Get instant insights into project progress with comprehensive dashboards and reports.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project Statistics for Guests -->
            <div class="row">
                <div class="col-12">
                    <div class="card bg-primary text-white shadow mb-3">
                        <div class="card-body text-center">
                            <h5 class="card-title mb-1"><i class='bx bxs-folder'></i> System Overview</h5>
                            <p class="card-text mb-0">@ViewBag.TotalProjectsCount Projects Managed Successfully</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="card bg-light shadow mb-3">
                        <div class="card-body text-center">
                            <h5 class="card-title text-muted mb-1"><i class='bx bx-radio-circle-marked text-secondary'></i> Planning</h5>
                            <p class="card-text fs-4 fw-bold">@ViewBag.NotStartedCount</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white shadow mb-3">
                        <div class="card-body text-center">
                            <h5 class="card-title mb-1"><i class='bx bxs-caret-up-circle'></i> In Development</h5>
                            <p class="card-text fs-4 fw-bold">@ViewBag.InProgressCount</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning shadow mb-3">
                        <div class="card-body text-center">
                            <h5 class="card-title mb-1"><i class='bx bx-stop-circle'></i> On Hold</h5>
                            <p class="card-text fs-4 fw-bold">@ViewBag.OnHoldCount</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white shadow mb-3">
                        <div class="card-body text-center">
                            <h5 class="card-title mb-1"><i class='bx bx-check-square'></i> Delivered</h5>
                            <p class="card-text fs-4 fw-bold">@ViewBag.CompletedCount</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Call to Action -->
            <div class="row mt-5">
                <div class="col-12 text-center">
                    <div class="card border-0 bg-light">
                        <div class="card-body py-5">
                            <h3 class="text-primary mb-3">Ready to Get Started?</h3>
                            <p class="text-muted mb-4">Join thousands of teams already managing their projects with FastPMS</p>
                            <div class="d-flex justify-content-center gap-3">
                                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                                    <i class='bx bx-user-plus me-2'></i>Start Free Trial
                                </a>
                                <a href="#features" class="btn btn-outline-primary btn-lg">
                                    <i class='bx bx-info-circle me-2'></i>Learn More
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    } 

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Chart data from ViewBag
            const projectData = {
                notStarted: @ViewBag.NotStartedCount,
                inProgress: @ViewBag.InProgressCount,
                onHold: @ViewBag.OnHoldCount,
                completed: @ViewBag.CompletedCount
            };

            const primaryColor = '#5932EA';
            const chartColors = [
                primaryColor,
                '#36A2EB',
                '#FF6384',
                '#4BC0C0'
            ];

            // Doughnut Chart
            const doughnutCtx = document.getElementById('projectStatusChart').getContext('2d');
            new Chart(doughnutCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Not Started', 'In Progress', 'On Hold', 'Completed'],
                    datasets: [{
                        data: [projectData.notStarted, projectData.inProgress, projectData.onHold, projectData.completed],
                        backgroundColor: chartColors,
                        borderColor: '#fff',
                        borderWidth: 2,
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true,
                                pointStyle: 'circle'
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.raw || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = Math.round((value / total) * 100);
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    },
                    cutout: '60%'
                }
            });

            // Pie Chart
            const pieCtx = document.getElementById('projectPieChart').getContext('2d');
            new Chart(pieCtx, {
                type: 'pie',
                data: {
                    labels: ['Not Started', 'In Progress', 'On Hold', 'Completed'],
                    datasets: [{
                        data: [projectData.notStarted, projectData.inProgress, projectData.onHold, projectData.completed],
                        backgroundColor: chartColors,
                        borderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                padding: 15,
                                usePointStyle: true
                            }
                        }
                    }
                }
            });

            // Bar Chart
            const barCtx = document.getElementById('projectBarChart').getContext('2d');
            new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: ['Not Started', 'In Progress', 'On Hold', 'Completed'],
                    datasets: [{
                        label: 'Number of Projects',
                        data: [projectData.notStarted, projectData.inProgress, projectData.onHold, projectData.completed],
                        backgroundColor: primaryColor,
                        borderColor: primaryColor,
                        borderWidth: 1,
                        borderRadius: 8,
                        barPercentage: 0.6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                drawBorder: false
                            },
                            ticks: {
                                stepSize: 1
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        });
    </script>

    <!-- Notification System Script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        // Notification SignalR Connection
        const notificationConnection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .build();

        // Start connection when page loads
        document.addEventListener('DOMContentLoaded', function() {
            @if (isAuthenticated)
            {
                    <text>
                    notificationConnection.start()
                        .then(() => {
                            console.log("✅ Notification Hub Connected");

                            // Join user group
                            notificationConnection.invoke("JoinNotificationGroup")
                                .then(() => console.log("✅ Joined notification group"));

                            // Load initial notifications
                            updateNotificationBadge();
                            loadNotificationDropdown();
                        })
                        .catch(err => {
                            console.error("❌ Notification Hub Connection Failed:", err);
                        });
                    </text>
            }

            // Setup dropdown event handlers
            setupNotificationDropdown();
        });

        // Handle incoming notifications
        notificationConnection.on("ReceiveNotification", (notification) => {
            console.log("📢 New notification:", notification);
            showNotificationToast(notification);
            updateNotificationBadge();
            loadNotificationDropdown();
        });

        // Update notification badge
        function updateNotificationBadge() {
            fetch('/Notification/GetUnreadCount')
                .then(response => response.json())
                .then(count => {
                    const badge = document.getElementById('notificationBadge');
                    if (badge) {
                        badge.textContent = count;
                        if (count > 0) {
                            badge.style.display = 'block';
                        } else {
                            badge.style.display = 'none';
                        }
                    }
                })
                .catch(err => console.error('Error updating badge:', err));
        }

        // Load notifications in dropdown
        function loadNotificationDropdown() {
            fetch('/Notification/GetNotifications')
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById('notificationList');
                    if (container) {
                        if (data.notifications && data.notifications.length > 0) {
                            container.innerHTML = data.notifications.map(notification => `
                                <div class="notification-item p-2 border-bottom ${!notification.isRead ? 'bg-light' : ''}"
                                     data-notification-id="${notification.id}">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <p class="mb-1 small">${notification.message}</p>
                                            <small class="text-muted">${formatTime(notification.createdAt)}</small>
                                        </div>
                                        ${!notification.isRead ? '<span class="badge bg-primary ms-2">New</span>' : ''}
                                    </div>
                                    ${!notification.isRead ? `
                                        <button class="btn btn-sm btn-outline-success mt-1 mark-as-read"
                                                data-id="${notification.id}">
                                            <i class='bx bx-check'></i> Mark Read
                                        </button>
                                    ` : ''}
                                </div>
                            `).join('');

                            // Add event listeners for mark-as-read buttons
                            container.querySelectorAll('.mark-as-read').forEach(button => {
                                button.addEventListener('click', function(e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    const notificationId = this.getAttribute('data-id');
                                    markAsRead(notificationId);
                                });
                            });
                        } else {
                            container.innerHTML = `
                                <div class="text-center text-muted py-3">
                                    <i class='bx bx-bell-off fs-1'></i>
                                    <p class="mb-0">No notifications</p>
                                </div>
                            `;
                        }
                    }
                })
                .catch(err => console.error('Error loading notifications:', err));
        }

        // Mark notification as read
        function markAsRead(notificationId) {
            fetch('/Notification/MarkAsRead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ notificationId: parseInt(notificationId) })
            })
            .then(response => {
                if (response.ok) {
                    updateNotificationBadge();
                    loadNotificationDropdown();
                }
            })
            .catch(err => console.error('Error marking as read:', err));
        }

        // Setup dropdown event handlers
        function setupNotificationDropdown() {
            // Refresh notifications when dropdown opens
            const notificationDropdown = document.getElementById('notificationDropdown');
            if (notificationDropdown) {
                notificationDropdown.addEventListener('click', function() {
                    loadNotificationDropdown();
                });
            }

            // Mark all as read
            const markAllAsRead = document.getElementById('markAllAsRead');
            if (markAllAsRead) {
                markAllAsRead.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    fetch('/Notification/MarkAllAsRead', { method: 'POST' })
                        .then(response => {
                            if (response.ok) {
                                updateNotificationBadge();
                                loadNotificationDropdown();
                                showNotificationToast({
                                    Id: 0,
                                    Message: "All notifications marked as read",
                                    Type: "success",
                                    CreatedAt: new Date().toLocaleString()
                                });
                            }
                        })
                        .catch(err => console.error('Error marking all as read:', err));
                });
            }

            // Refresh notifications
            const refreshNotifications = document.getElementById('refreshNotifications');
            if (refreshNotifications) {
                refreshNotifications.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    loadNotificationDropdown();
                });
            }
        }

        // Show notification as toast
        function showNotificationToast(notification) {
            const toastId = 'toast-' + Date.now();
            const toastHtml = `
                <div id="${toastId}" class="toast show align-items-center text-bg-${getNotificationColor(notification.Type)} border-0 mb-2" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <div class="d-flex align-items-center">
                                <i class='bx ${getNotificationIcon(notification.Type)} me-2'></i>
                                <div>
                                    <strong class="me-auto">${notification.Type.toUpperCase()}</strong>
                                    <div>${notification.Message}</div>
                                    <small class="text-muted">${notification.CreatedAt}</small>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            let container = document.getElementById('notificationContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'notificationContainer';
                container.className = 'position-fixed top-0 end-0 p-3';
                container.style.zIndex = '9999';
                container.style.width = '350px';
                document.body.appendChild(container);
            }

            container.insertAdjacentHTML('afterbegin', toastHtml);

            // Auto remove after 5 seconds
            setTimeout(() => {
                const toastElement = document.getElementById(toastId);
                if (toastElement) {
                    toastElement.remove();
                }
            }, 5000);
        }

        // Helper functions
        function getNotificationColor(type) {
            const colors = {
                'success': 'success',
                'task': 'primary',
                'project': 'info',
                'message': 'success',
                'warning': 'warning',
                'error': 'danger',
                'system': 'secondary'
            };
            return colors[type.toLowerCase()] || 'info';
        }

        function getNotificationIcon(type) {
            const icons = {
                'success': 'bx-check-circle',
                'task': 'bx-task',
                'project': 'bx-folder',
                'message': 'bx-message',
                'warning': 'bx-error',
                'error': 'bx-error-circle',
                'system': 'bx-cog'
            };
            return icons[type.toLowerCase()] || 'bx-bell';
        }

        function formatTime(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffMs = now - date;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Just now';
            if (diffMins < 60) return `${diffMins}m ago`;
            if (diffHours < 24) return `${diffHours}h ago`;
            if (diffDays < 7) return `${diffDays}d ago`;
            return date.toLocaleDateString();
        }

        // Manual test function
        window.testNotification = function() {
            notificationConnection.invoke("TestNotification", "Test from browser console")
                .then(() => console.log("Test notification sent"))
                .catch(err => console.error("Test failed:", err));
        };
    </script>

    <!-- Notification Toast Container -->
    <div id="notificationContainer"></div>
</body>
<script src="~/js/SideBar.js"></script>
</html>